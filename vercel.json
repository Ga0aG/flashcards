{
  "outputDirectory": "build/web",
  "functions": {
    "api/furigana.js": {
      "maxDuration": 10,
      "includeFiles": "node_modules/kuromoji/dict/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
